# Copy to .env for local runs. Never commit real values; secrets live only on the server
# and in GitHub's secret variables.

# API
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_ENV=development
# Set by the build; shown by /version.
APP_VERSION=
GIT_COMMIT=

# Web (development server only)
API_URL=http://localhost:3000

# From M3: database
# SYSTEM_DATABASE_URL=postgres://grid_system:CHANGE_ME@localhost:5432/grid_system
