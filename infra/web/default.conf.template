# nginx for the web container. ${API_UPSTREAM} is filled in from the environment at start;
# nginx variables such as $uri are left as they are.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # The API, reached by the browser on the same origin.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Built files have content hashes in their names and never change.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The app: always revalidate index.html so that a new release is picked up.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
